# ─────────────────────────────────────────────────────────────────────────────
# Wasel Backend — Environment Variables
# Copy this file to .env and fill in the real values.
# .env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────

# Your Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Service role key — grants full DB access, bypasses RLS.
# Keep this secret. Never expose it in client code or commit it to git.
# (Settings → API → service_role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anon / public key — safe for client-side use, constrained by RLS.
# (Settings → API → anon key)
SUPABASE_ANON_KEY=your-anon-key-here

# ── Server ────────────────────────────────────────────────────────────────────

PORT=3001

# ── Environment ───────────────────────────────────────────────────────────────

# IMPORTANT: Must be set to 'production' in all production deployments.
# When this is any value other than 'production', the dev OTP bypass
# (magic phone numbers + OTP 123456) and the /api/auth/dev-login endpoint
# are both active. Leaving this unset or set to any other string in a
# production-connected environment is a critical security vulnerability.
NODE_ENV=development

# ── Wasel Feature Flags ───────────────────────────────────────────────────────

# Set to 'true' to enable waitlist-only mode (public launch gate).
WAITLIST_MODE=true

# CORS allowed origins — comma-separated list of allowed request origins.
# Example: https://app.wasel.jo,https://rider.wasel.jo
# Leave unset to allow all origins (acceptable for mobile-only APIs with
# no browser/cookie surface, but should be tightened once domains are final).
# ALLOWED_ORIGINS=

# ── Development / Test Accounts ───────────────────────────────────────────────

# Password used for the two test Supabase Auth accounts created by the dev
# OTP bypass (test-rider@wasel.dev and test-driver@wasel.dev).
# Override this in any non-local environment (staging, CI) even though the
# bypass is gated by NODE_ENV — defence in depth against misconfiguration.
# This variable has no effect when NODE_ENV=production.
DEV_TEST_PASSWORD=change-me-in-staging
