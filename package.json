{
  "name": "wasel-mvp",
  "private": true,
  "workspaces": [
    "packages/*",
    "rider",
    "driver"
  ],
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "preinstall": "node -e \"var m=+process.versions.node.split('.')[0]; if (m!==20) { console.error('Wasel MVP requires Node 20.x exactly. You are on '+process.version+'. See .nvmrc. Run: nvm use'); process.exit(1); }\"",
    "rider": "npm start --workspace=rider",
    "driver": "npm start --workspace=driver",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "supabase": "^2.92.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
