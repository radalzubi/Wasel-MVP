# ─────────────────────────────────────────────────────────────────────────────
# .ship-secrets — credentials for ship.sh
#
# HOW TO SET UP (one time only):
#
# 1. APPLE_TEAM_ID
#    Go to: https://developer.apple.com/account
#    Look for "Team ID" — it's a 10-character code like A1B2C3D4E5
#
# 2. ASC_KEY_ID + ASC_ISSUER_ID + the .p8 key file
#    Go to: https://appstoreconnect.apple.com → Users and Access → Integrations → App Store Connect API
#    Click "+" to create a new key (role: App Manager or Admin)
#    Copy the Key ID and Issuer ID into this file
#    Download the .p8 file — you can only download it ONCE
#    Move it to: ~/.private_keys/AuthKey_YOURKEYID.p8
#    Example: ~/.private_keys/AuthKey_A1B2C3D4E5.p8
#
# 3. API_URL
#    Your Railway backend URL — already set correctly below.
#
# Copy this file to .ship-secrets (no .example) and fill in the real values.
# .ship-secrets is gitignored — it will never be committed.
# ─────────────────────────────────────────────────────────────────────────────

APPLE_TEAM_ID="XXXXXXXXXX"

ASC_KEY_ID="XXXXXXXXXX"
ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

API_URL="https://wasel-mvp-production.up.railway.app"
