{
  "expo": {
    "name": "Wasel Rider",
    "slug": "wasel-rider",
    "version": "1.0.0",
    "scheme": "wasel-rider",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "bundleIdentifier": "com.wasel.rider",
      "supportsTablet": false,
      "config": {
        "googleMapsApiKey": "GOOGLE_MAPS_API_KEY_IOS"
      }
    },
    "android": {
      "package": "com.wasel.rider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_API_KEY_ANDROID"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Wasel needs your location to find nearby drivers.",
          "locationWhenInUsePermission": "Wasel needs your location to find nearby drivers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
