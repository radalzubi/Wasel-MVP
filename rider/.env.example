# Wasel Rider App — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env — it is listed in .gitignore.
#
# IMPORTANT: The Google Maps key that was previously hardcoded in app.json
# (<GOOGLE_MAPS_API_KEY>) is now in git history and MUST
# be rotated in Google Cloud Console. Only put the new key here.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and anon key from Supabase → Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend ───────────────────────────────────────────────────────────────────
# URL of the Wasel Express backend.
# Local: http://localhost:3001
# Production: https://api.wasel.app (update when deployed)
EXPO_PUBLIC_API_URL=http://localhost:3001

# ── Google Maps ───────────────────────────────────────────────────────────────
# Used by the native Maps SDK (injected by app.config.js at build time).
# For EAS Build: set this as an EAS secret instead of putting it here.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to block all API routes and show the waitlist screen.
EXPO_PUBLIC_WAITLIST_MODE=false
